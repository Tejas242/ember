{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tejas242/ember/docs/plugin-protocol.schema.json",
  "title": "Ember plugin protocol v1",
  "description": "One JSON object per line, at most 64 KiB, both ways. Unknown types and fields are ignored. Text over its maxLength is cut, lists over maxItems are cut, numbers are clamped: those are not errors. See docs/PLUGINS.md.",
  "$defs": {
    "mood": {
      "enum": [
        "work",
        "wait",
        "nudge",
        "done",
        "fail",
        "quiet"
      ],
      "description": "An unknown value reads as the default."
    },
    "icon": {
      "type": "string",
      "maxLength": 32,
      "description": "An Ember icon name; an unknown one shows no icon."
    },
    "hello_ember": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "v": {
          "type": "integer",
          "minimum": 1
        },
        "ember": {
          "type": "string",
          "maxLength": 64
        },
        "caps": {
          "type": "array",
          "items": {
            "enum": [
              "pill",
              "moment",
              "row",
              "card",
              "dashboard",
              "cheer"
            ]
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "enum": [
              "critical",
              "badge",
              "focus",
              "media",
              "entry"
            ]
          },
          "description": "What the user's config grants the plugin."
        }
      },
      "required": [
        "type",
        "v",
        "ember",
        "caps"
      ],
      "description": "Ember's first line."
    },
    "click": {
      "type": "object",
      "properties": {
        "type": {
          "const": "click"
        },
        "target": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "type",
        "target"
      ],
      "description": "A click on the plugin's moment or row."
    },
    "button": {
      "type": "object",
      "properties": {
        "type": {
          "const": "button"
        },
        "card": {
          "type": "string",
          "maxLength": 64
        },
        "key": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "type",
        "card",
        "key"
      ],
      "description": "A button picked on the plugin's card."
    },
    "dash": {
      "type": "object",
      "properties": {
        "type": {
          "const": "dash"
        },
        "state": {
          "enum": [
            "open",
            "close"
          ]
        },
        "reason": {
          "enum": [
            "user",
            "pointer",
            "media_idle",
            "song_end",
            "other"
          ],
          "description": "Why it closed (with state close)."
        }
      },
      "required": [
        "type",
        "state"
      ]
    },
    "stop": {
      "type": "object",
      "properties": {
        "type": {
          "const": "stop"
        }
      },
      "required": [
        "type"
      ],
      "description": "Exit within 2 seconds."
    },
    "tool": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool"
        },
        "payload": {
          "description": "what the plugin's tool sent to Ember's socket for it"
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "description": "A message from the plugin's own tool."
    },
    "hello_plugin": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "v": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        }
      },
      "required": [
        "type",
        "v",
        "name"
      ],
      "description": "The plugin's answer, within 5 seconds."
    },
    "status": {
      "type": "object",
      "properties": {
        "type": {
          "const": "status"
        },
        "text": {
          "type": "string",
          "maxLength": 40
        },
        "sub": {
          "type": "string",
          "maxLength": 40
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "mood": {
          "$ref": "#/$defs/mood"
        },
        "since_ms": {
          "type": "integer",
          "description": "Unix milliseconds"
        },
        "until_ms": {
          "type": "integer",
          "description": "Unix milliseconds"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "urgency": {
          "enum": [
            "low",
            "normal",
            "high",
            "critical"
          ],
          "description": "critical needs the critical grant"
        },
        "salience": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "capped at 0.75, 0.95 with the critical grant"
        },
        "timer": {
          "enum": [
            "auto",
            "none",
            "h:mm"
          ]
        },
        "warn_ms": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "string",
          "maxLength": 20
        },
        "chips": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 4
              },
              "state": {
                "enum": [
                  "done",
                  "tried",
                  "owed",
                  "fixed",
                  "gone",
                  "todo"
                ]
              }
            },
            "required": [
              "label"
            ]
          }
        },
        "badge": {
          "$ref": "#/$defs/icon"
        },
        "badge_clock": {
          "$ref": "#/$defs/icon",
          "description": "an icon on the clock: the badge grant"
        },
        "satellite": {
          "type": "boolean"
        },
        "focus": {
          "type": "boolean",
          "description": "the focus grant"
        },
        "id": {
          "type": "string",
          "maxLength": 32,
          "description": "ember status only: the line's name"
        },
        "ttl_s": {
          "type": "number",
          "description": "ember status only: seconds until it expires, ≤ 86400"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "description": "The pill line (capability pill). 10/s, coalesced."
    },
    "moment": {
      "type": "object",
      "properties": {
        "type": {
          "const": "moment"
        },
        "text": {
          "type": "string",
          "maxLength": 40
        },
        "sub": {
          "type": "string",
          "maxLength": 40
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "mood": {
          "$ref": "#/$defs/mood"
        },
        "ttl_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "target": {
          "type": "string",
          "maxLength": 32
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "description": "ember note --open only"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "description": "A short note (capability moment). 1 every 10 s."
    },
    "row": {
      "type": "object",
      "properties": {
        "type": {
          "const": "row"
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "sub": {
          "type": "string",
          "maxLength": 60
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "mood": {
          "$ref": "#/$defs/mood"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "target": {
          "type": "string",
          "maxLength": 32
        },
        "ring": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "start_ms": {
              "type": "integer"
            },
            "end_ms": {
              "type": "integer"
            },
            "mood": {
              "$ref": "#/$defs/mood"
            },
            "sweep": {
              "type": "boolean"
            }
          }
        },
        "buttons": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 32
              },
              "label": {
                "type": "string",
                "maxLength": 24
              },
              "primary": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label"
            ]
          }
        },
        "chips": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 4
              },
              "state": {
                "enum": [
                  "done",
                  "tried",
                  "owed",
                  "fixed",
                  "gone",
                  "todo"
                ]
              }
            },
            "required": [
              "label"
            ]
          }
        },
        "badge": {
          "$ref": "#/$defs/icon"
        },
        "flame": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "type",
        "title"
      ],
      "description": "The row in the open card (capability row). 10/s, coalesced."
    },
    "card": {
      "type": "object",
      "properties": {
        "type": {
          "const": "card"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "eyebrow": {
          "type": "string",
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "maxLength": 280
        },
        "mood": {
          "$ref": "#/$defs/mood"
        },
        "ttl_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 600
        },
        "buttons": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 32
              },
              "label": {
                "type": "string",
                "maxLength": 24
              },
              "primary": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label"
            ]
          }
        },
        "urgent": {
          "type": "boolean",
          "description": "the critical grant"
        }
      },
      "required": [
        "type",
        "id",
        "title"
      ],
      "description": "A question or an offer (capability card). 3 open, 1 new a second."
    },
    "widget": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hero",
            "stats",
            "sparkline",
            "line",
            "bars",
            "chips",
            "list",
            "heatmap",
            "agenda",
            "columns",
            "note",
            "stage",
            "timed_text",
            "media",
            "sessions",
            "audio",
            "countdown"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 32
        },
        "caption": {
          "type": "string",
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "maxLength": 80
        },
        "fold": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "auto"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "hero"
            },
            "ring": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "goal": {
                  "type": "number"
                },
                "mode": {
                  "enum": [
                    "fill",
                    "countdown"
                  ]
                },
                "start_ms": {
                  "type": "integer"
                },
                "end_ms": {
                  "type": "integer"
                },
                "mood": {
                  "$ref": "#/$defs/mood"
                }
              }
            },
            "ember": {
              "type": "object",
              "properties": {
                "mood": {
                  "$ref": "#/$defs/mood"
                },
                "pose": {
                  "enum": [
                    "calm",
                    "attentive",
                    "sidelong",
                    "game",
                    "sleepy",
                    "proud"
                  ]
                },
                "react": {
                  "enum": [
                    "hop",
                    "nod",
                    "celebrate"
                  ]
                }
              }
            },
            "aside": {
              "type": "string",
              "maxLength": 12
            },
            "sub": {
              "type": "string",
              "maxLength": 60
            },
            "sub_icon": {
              "$ref": "#/$defs/icon"
            },
            "sub_mood": {
              "$ref": "#/$defs/mood"
            },
            "chips": {
              "type": "array",
              "maxItems": 9,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 4
                  },
                  "state": {
                    "enum": [
                      "done",
                      "tried",
                      "owed",
                      "fixed",
                      "gone",
                      "todo"
                    ]
                  }
                },
                "required": [
                  "label"
                ]
              }
            },
            "stat": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 6
                },
                "caption": {
                  "type": "string",
                  "maxLength": 16
                }
              }
            },
            "step": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "maxLength": 12
                },
                "tag_mood": {
                  "$ref": "#/$defs/mood"
                },
                "text": {
                  "type": "string",
                  "maxLength": 48
                },
                "meta": {
                  "type": "string",
                  "maxLength": 12
                },
                "facts": {
                  "type": "string",
                  "maxLength": 32
                },
                "dots": {
                  "type": "object",
                  "properties": {
                    "used": {
                      "type": "integer"
                    },
                    "ready": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer",
                      "maximum": 5
                    },
                    "next": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            },
            "buttons": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "primary": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "key",
                  "label"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "stats"
            },
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "count_up": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "unit": {
                    "enum": [
                      "",
                      "%",
                      "s"
                    ]
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "mood": {
                    "$ref": "#/$defs/mood"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "sparkline"
            },
            "values": {
              "type": "array",
              "maxItems": 120,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "line"
            },
            "values": {
              "type": "array",
              "maxItems": 120,
              "items": {
                "type": "number"
              }
            },
            "value": {
              "type": "string",
              "maxLength": 12
            },
            "delta": {
              "type": "string",
              "maxLength": 12
            },
            "delta_mood": {
              "$ref": "#/$defs/mood"
            },
            "extra": {
              "type": "string",
              "maxLength": 12
            },
            "band": {
              "type": "object",
              "properties": {
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                },
                "label": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "lo",
                "hi"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "bars"
            },
            "layout": {
              "enum": [
                "rows",
                "columns"
              ]
            },
            "value": {
              "type": "string",
              "maxLength": 12
            },
            "items": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 12
                  },
                  "target": {
                    "type": "number",
                    "minimum": 0
                  },
                  "today": {
                    "type": "boolean"
                  },
                  "mood": {
                    "$ref": "#/$defs/mood"
                  },
                  "state": {
                    "enum": [
                      "",
                      "future",
                      "excused"
                    ]
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "chips"
            },
            "items": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 4
                  },
                  "state": {
                    "enum": [
                      "done",
                      "tried",
                      "owed",
                      "fixed",
                      "gone",
                      "todo"
                    ]
                  }
                },
                "required": [
                  "label"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "sub": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "icon": {
                    "$ref": "#/$defs/icon"
                  },
                  "mood": {
                    "$ref": "#/$defs/mood"
                  },
                  "mark": {
                    "enum": [
                      "done",
                      "skip",
                      "fail",
                      "none"
                    ]
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "heatmap"
            },
            "weeks": {
              "type": "integer",
              "minimum": 4,
              "maximum": 53
            },
            "days": {
              "type": "array",
              "maxItems": 371,
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "level": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "mood": {
                    "$ref": "#/$defs/mood"
                  }
                },
                "required": [
                  "date"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "agenda"
            },
            "day_ends": {
              "type": "string",
              "maxLength": 5
            },
            "empty": {
              "type": "string",
              "maxLength": 60
            },
            "items": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "at_ms": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "tag": {
                    "type": "string",
                    "maxLength": 14
                  },
                  "tag_mood": {
                    "$ref": "#/$defs/mood"
                  },
                  "chips": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "maxLength": 4
                        },
                        "state": {
                          "enum": [
                            "done",
                            "tried",
                            "owed",
                            "fixed",
                            "gone",
                            "todo"
                          ]
                        }
                      },
                      "required": [
                        "label"
                      ]
                    }
                  }
                },
                "required": [
                  "at_ms",
                  "title"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "columns"
            },
            "split": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 0.7
            },
            "a": {
              "$ref": "#/$defs/widget"
            },
            "b": {
              "$ref": "#/$defs/widget"
            }
          },
          "required": [
            "a",
            "b"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "note"
            },
            "icon": {
              "$ref": "#/$defs/icon"
            },
            "text": {
              "type": "string",
              "maxLength": 80
            },
            "mood": {
              "$ref": "#/$defs/mood"
            }
          },
          "required": [
            "text"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "stage"
            },
            "ember": {
              "type": "object",
              "properties": {
                "dance": {
                  "enum": [
                    "music",
                    "still"
                  ]
                },
                "sing": {
                  "type": "boolean"
                },
                "pose": {
                  "enum": [
                    "calm",
                    "attentive",
                    "sleepy"
                  ]
                },
                "mood": {
                  "$ref": "#/$defs/mood"
                }
              }
            },
            "light": {
              "enum": [
                "audio",
                "still",
                "none"
              ]
            },
            "haze": {
              "enum": [
                "cover",
                "none"
              ]
            }
          },
          "description": "First on the page, once: Ember on a stage."
        },
        {
          "properties": {
            "kind": {
              "const": "timed_text"
            },
            "media_key": {
              "type": "string",
              "maxLength": 64
            },
            "clock": {
              "type": "object",
              "properties": {
                "pos_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "at_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": [
                "pos_ms",
                "at_ms"
              ]
            },
            "mode": {
              "enum": [
                "synced",
                "stanzas"
              ]
            },
            "state": {
              "enum": [
                "loading",
                "ready",
                "none",
                "instrumental",
                "spoken"
              ]
            },
            "caption": {
              "type": "string",
              "maxLength": 60
            },
            "lines": {
              "type": "array",
              "maxItems": 400,
              "items": {
                "type": "object",
                "properties": {
                  "t_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "words": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "properties": {
                        "t_ms": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "n": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 160
                        }
                      },
                      "required": [
                        "t_ms",
                        "n"
                      ]
                    }
                  }
                },
                "required": [
                  "t_ms",
                  "text"
                ]
              }
            }
          },
          "description": "Words on a clock: the media playhead (media_key) or its own clock. 60 KiB of words in all."
        },
        {
          "properties": {
            "kind": {
              "const": "media"
            }
          },
          "description": "The song playing, from Ember's own data."
        },
        {
          "properties": {
            "kind": {
              "const": "sessions"
            },
            "style": {
              "enum": [
                "line"
              ]
            }
          },
          "description": "Claude's sessions in one line, from Ember's own data."
        },
        {
          "properties": {
            "kind": {
              "const": "audio"
            },
            "style": {
              "enum": [
                "ribbon"
              ]
            },
            "tint": {
              "enum": [
                "cover",
                "quiet"
              ]
            }
          },
          "description": "The song's last seconds as a ribbon; the levels never leave Ember."
        },
        {
          "properties": {
            "kind": {
              "const": "countdown"
            },
            "text": {
              "type": "string",
              "maxLength": 40
            },
            "to": {
              "enum": [
                "media_end"
              ]
            }
          },
          "description": "Time left in the media playing, with a draining hairline."
        }
      ]
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "type": {
          "const": "dashboard"
        },
        "title": {
          "type": "string",
          "maxLength": 32
        },
        "widgets": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/widget"
          }
        },
        "size": {
          "enum": [
            "page",
            "card"
          ]
        },
        "sticky": {
          "type": "boolean"
        },
        "ends": {
          "type": "object",
          "properties": {
            "media_idle_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 600
            },
            "after_claude": {
              "enum": [
                "song_end"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "widgets"
      ],
      "description": "The plugin's page (capability dashboard). 4/s, coalesced; 1/s with timed_text."
    },
    "cheer": {
      "type": "object",
      "properties": {
        "type": {
          "const": "cheer"
        },
        "kind": {
          "enum": [
            "hop",
            "nod",
            "celebrate"
          ]
        }
      },
      "required": [
        "type",
        "kind"
      ],
      "description": "Ask Ember to react (capability cheer). Gated, 1 a minute."
    },
    "log": {
      "type": "object",
      "properties": {
        "type": {
          "const": "log"
        },
        "level": {
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "type",
        "text"
      ],
      "description": "A log line. 5/s."
    },
    "remove": {
      "type": "object",
      "properties": {
        "type": {
          "const": "remove"
        },
        "what": {
          "enum": [
            "status",
            "row",
            "card",
            "dashboard"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "type",
        "what"
      ],
      "description": "Take something back; a card needs its id."
    },
    "media": {
      "type": "object",
      "properties": {
        "type": {
          "const": "media"
        },
        "media_key": {
          "type": "string",
          "maxLength": 64,
          "description": "Ember's name for this track on this player: a timed_text's media_key. Absent: nothing plays."
        },
        "player": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "album": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "the track's own address (file:// for a local file)"
        },
        "track_id": {
          "type": "string",
          "description": "the player's id for the track (mpris:trackid)"
        },
        "length_ms": {
          "type": "integer",
          "minimum": 0
        },
        "pos_ms": {
          "type": "integer",
          "minimum": 0
        },
        "at_ms": {
          "type": "integer"
        },
        "playing": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "description": "The song playing (the media grant): only while the plugin's dashboard is open, as it opens and when it changes."
    }
  },
