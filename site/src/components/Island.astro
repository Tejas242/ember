---
// The island, as a web page can have it: a dark pill hanging from the bar at
// the top of the window. The page directs it (scripts/page.ts): it acts out
// the part of the day you're reading, morphing between views on springs, the
// way Ember's renderer does. Hover drops a card; it sleeps if you leave it be.
import Moment from "./Moment.astro"

const hours = [0, 0, 0, 0, 0, 0, 0, 0, 0, 2, 9, 31, 6, 0, 14, 22, 8, 0, 0, 0, 0, 0, 0, 0]
---

<ember-island data-state="clock" data-session="none">
  <div class="isl" role="group" aria-label="Ember, the island">
    <span class="ear l" aria-hidden="true"></span><span class="ear r" aria-hidden="true"></span>
    <div class="clip">

    <div class="view pill" data-view="clock">
      <ember-flame class="lead" mood="idle" data-energy="0.45"></ember-flame>
      <span class="label" data-clock>9:04 AM</span>
      <span class="zz" aria-hidden="true"><i>z</i><i>z</i><i>z</i></span>
    </div>

    <div class="view pill" data-view="missed">
      <ember-flame class="lead" mood="idle" data-energy="0.5"></ember-flame>
      <span class="label" data-clock>11:53 AM</span>
      <span class="news">kinvault done</span>
    </div>

    <div class="view pill" data-view="work">
      <ember-flame class="lead" mood="work" data-energy="0.75"></ember-flame>
      <span class="label shimmer">kinvault</span>
      <span class="timer" data-timer>1m</span>
    </div>

    <div class="view pill" data-view="wait">
      <ember-flame class="lead" mood="wait" data-energy="0.6"></ember-flame>
      <span class="label wait">kinvault needs you</span>
    </div>

    <div class="view pill" data-view="done">
      <ember-flame class="lead" mood="happy" data-energy="0.8"></ember-flame>
      <span class="verb">Done</span><span class="label">kinvault</span>
      <span class="sub">All 42 tests pass under -race</span>
      <svg class="check" viewBox="0 0 12 10" aria-hidden="true"><path d="M1 5.2 4.3 8.4 11 1.4" /></svg>
      <i class="sweep" aria-hidden="true"></i>
    </div>

    <div class="view pill" data-view="away">
      <ember-flame class="lead" mood="happy" data-energy="0.7"></ember-flame>
      <span class="label">While you were away</span>
      <span class="sub">kinvault done · edge asked once</span>
    </div>

    <div class="view pill moment m-music" data-view="music"><Moment kind="music" /></div>
    <div class="view pill moment m-volume" data-view="volume" data-w="196"><Moment kind="volume" /></div>
    <div class="view pill moment m-bright" data-view="bright" data-w="196"><Moment kind="bright" /></div>
    <div class="view pill moment m-phones" data-view="phones"><Moment kind="phones" /></div>
    <div class="view pill moment m-shot" data-view="shot"><Moment kind="shot" /></div>
    <div class="view pill moment m-charge" data-view="charge"><Moment kind="charge" /></div>

    <div class="view card" data-view="card" data-w="380">
      <div class="head">
        <ember-flame class="big" mood="work" data-energy="0.75"></ember-flame>
        <div>
          <p class="title">Fix the race in the store's compaction path</p>
          <p class="facts live-only">kinvault · <span data-timer>3m</span> in · 2 files <b class="g">+23</b> <b class="r">−6</b> · 1 retry</p>
          <p class="facts done-only">kinvault · finished just now · took 12m · <b class="g">+23</b> <b class="r">−6</b></p>
        </div>
        <span class="time" data-clock>11:44 AM</span>
      </div>
      <ol class="steps live-only" data-steps>
        <li class="thread" aria-hidden="true"><i class="live"></i><i class="bead"></i></li>
      </ol>
      <p class="reply done-only">Fixed the race in the store's compaction path: writers now take the segment lock before rotating, and all 42 tests pass under -race.</p>
    </div>

    <div class="view card" data-view="day" data-w="380">
      <div class="head">
        <ember-flame class="big" mood="idle" data-energy="0.5"></ember-flame>
        <div>
          <p class="title" data-greeting>Good morning</p>
          <p class="facts" data-dayline>Nothing running · 3 tasks yesterday</p>
        </div>
        <span class="time" data-clock>9:04 AM</span>
      </div>
      <div class="hours" aria-hidden="true">
        {hours.map((n, h) => <i data-h={h} style={`--n:${n}`}></i>)}
      </div>
      <div class="hour-axis" aria-hidden="true"><span>12a</span><span>6a</span><span>12p</span><span>6p</span></div>
    </div>

    <div class="view card" data-view="request" data-w="380">
      <div class="head">
        <ember-flame class="big" mood="wait" data-energy="0.6"></ember-flame>
        <div>
          <p class="kicker">kinvault wants to run</p>
          <p class="title">Run the whole suite under the race detector</p>
        </div>
      </div>
      <pre class="code"><span class="p">go</span> test <span class="f">-race</span> <span class="f">-count=1</span> ./store/...</pre>
      <p class="note">Always allows <code>go test:*</code> in this project</p>
      <div class="buttons">
        <button type="button" class="link" data-act="terminal">Answer in terminal</button>
        <span class="grow"></span>
        <button type="button" class="btn deny" data-act="deny">Deny</button>
        <button type="button" class="btn" data-act="always">Always</button>
        <button type="button" class="btn primary" data-act="allow">Allow</button>
      </div>
      <i class="countdown" aria-hidden="true"></i>
    </div>
    </div>
  </div>
  <p class="sr" aria-live="polite" data-say></p>
</ember-island>

<script>
  import "@/scripts/island"
</script>
