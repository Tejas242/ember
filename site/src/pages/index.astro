---
import Island from "@/components/Island.astro"
import Moment from "@/components/Moment.astro"
import "@/styles/global.css"
import "@/styles/island.css"
import "@/styles/page.css"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const media = (f: string) => `${base}/media/${f}`
const repo = "https://github.com/Tejas242/ember"
const title = "Ember: a dynamic island for Wayland"
const description =
  "A dynamic island for Wayland, made for Claude Code. It follows your sessions while you look elsewhere, lets you answer their requests from the top of the screen, keeps time with your music and falls asleep when you do. One Go binary, drawn in software."

// the story's session, one beat per screen of scrolling
const beats = [
  { at: "11:40 AM", title: "You hand Claude a task.", body: "The pill names the project, and a band of light runs across it for as long as Claude is working." },
  { at: "11:41 AM", title: "Then you go read something else.", body: "The terminal scrolls out of sight. The work doesn't: it stays in the corner of your eye, the minutes rolling." },
  { at: "11:44 AM", title: "Glance up, and the work hangs from a thread.", body: "Hover the pill and the card drops: the task in words, one line of facts, each step arriving down a thread from Ember. A failed test says so, in red." },
  { at: "11:46 AM", title: "Claude wants to run something.", body: "The request drops out of the island with the whole command and exactly what Always would allow. Answer it from up there. Go on, press Allow.", tone: "b" },
  { at: "11:52 AM", title: "Done, in one sentence.", body: "Ember reads the reply and keeps the sentence with the outcome in it. You get “all 42 tests pass under -race”, never “Great question!”.", tone: "g" },
  { at: "11:53 AM", title: "And if you missed it, it waits.", body: "The news sits by the clock until you've looked. A turn that stopped never passes for a success: it says Stopped, in red, with the reason." },
]

const moments = [
  { kind: "music", name: "Music", text: "The cover spins in a ring that fills as the song plays. The equaliser hears the real output: low, mid and high, 25 times a second." },
  { kind: "volume", name: "Volume", text: "The waves come and go with the level. At 100 the meter stretches, so you can feel there's no 101." },
  { kind: "bright", name: "Brightness", text: "The sun's rays lengthen with the light, read straight from the backlight." },
  { kind: "phones", name: "Headphones", text: "Connected, with their battery: a number your bar doesn't have." },
  { kind: "shot", name: "Screenshots", text: "A shutter flash, and the shot drops in, already on the clipboard." },
  { kind: "charge", name: "The charger", text: "Plugged in, with the time until full, and nothing at all once it is." },
] as const

const sources = [
  { name: "Claude Code", via: "hooks, over a socket", rate: 1.4, tone: "g" },
  { name: "Music", via: "MPRIS, on D-Bus", rate: 0.35, tone: "a" },
  { name: "Battery", via: "UPower, on D-Bus", rate: 0.12, tone: "" },
  { name: "Backlight", via: "inotify", rate: 0.2, tone: "" },
  { name: "Screenshots", via: "inotify", rate: 0.1, tone: "" },
  { name: "Windows", via: "niri's event stream", rate: 0.6, tone: "b" },
]

const reel = [
  { src: "site-card-0.webp", cap: "Working: the timeline hangs from Ember" },
  { src: "site-card-1.webp", cap: "Three sessions: the one you can't see is the hero" },
  { src: "site-request-0.webp", cap: "A command, wrapped, never cut" },
  { src: "site-request-2.webp", cap: "A question, as one numbered list" },
  { src: "site-card-3.webp", cap: "Just finished: the sentence that matters" },
  { src: "site-card-4.webp", cap: "A quiet day, in 24 bars" },
  { src: "site-card-5.webp", cap: "Subagents, each opening into its steps" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a09" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(media("social.png"), Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>

    <header class="bar" aria-label="Site">
      <a class="brand" href="#top" aria-label="Ember, back to the top">
        <span class="ws" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="wintitle" data-wintitle>ember — morning</span>
      </a>
      <nav>
        <a href="#story">Story</a>
        <a href="#install">Install</a>
        <a href={`${repo}/blob/main/docs/DESIGN.md`}>Design</a>
        <a href={repo} class="gh">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .2a8 8 0 0 0-2.5 15.6c.4 0 .5-.2.5-.4v-1.5c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.5 7.5 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.8-3.6 4 .3.3.6.8.6 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 .2"/></svg>
          GitHub
        </a>
      </nav>
    </header>

    <Island />

    <main id="top">
      <!-- 9 AM: the island, magnified, docks into the bar as you scroll -->
      <section class="hero" data-scene="hero" data-time="9:04" data-until="9:30" data-title="ember — morning">
        <div class="cone" aria-hidden="true"></div>
        <div class="hero-in">
          <p class="eyebrow" data-rise>Ember <i></i> a dynamic island for Wayland</p>
          <h1 data-words>The top of your screen, <span class="em">paying attention.</span></h1>
          <p class="lede" data-rise>
            Ember hangs from your bar like a notch with a pulse. It follows Claude Code while you look elsewhere, lets
            you answer its requests from up here, keeps time with your music, and falls asleep when you do.
          </p>
          <div class="ctas" data-rise>
            <a class="cta primary" href={repo}>Get it on GitHub</a>
            <a class="cta" href="#story">Watch it live a day <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <a class="cue" href="#prologue" data-rise>
          <span class="mono">9:04 AM</span>
          <span>Scroll, and it lives through a day</span>
          <i aria-hidden="true"></i>
        </a>
      </section>

      <section class="prologue wrap" id="prologue" data-time="9:30" data-until="11:38" data-title="ember — what it's for">
        <p class="lit" data-lit>
          Your bar already shows the workspaces, the window and the battery. It can't tell you whether Claude is still
          working, whether it's waiting on you, or what just finished. You look up for under two seconds.
          <b>Ember answers.</b>
        </p>
        <ul class="trio mono" data-rise>
          <li class="b">Does anything need me?</li>
          <li class="g">Is the work going well?</li>
          <li>What happened?</li>
        </ul>
      </section>

      <!-- noon: a session, pinned, one beat per screen -->
      <section class="session" id="story" data-scene="session" data-time="11:40" data-until="11:54" data-title="kinvault — claude" style={`--beats:${beats.length}`}>
        <div class="stage">
          <div class="desk" data-desk data-beat="0" aria-hidden="true">
            <div class="strip">
              <article class="win term">
                <header><span class="dots"><i></i><i></i><i></i></span><span>kinvault — claude</span></header>
                <div class="tbody mono">
                  <p class="prompt"><span class="caret">›</span> <span data-type="fix the race in the store's compaction path"></span><i class="cursor"></i></p>
                  <p data-at="0.45"><b class="g">●</b> Read <span class="arg">store/compact.go</span></p>
                  <p data-at="0.75"><b class="g">●</b> Search <span class="arg">segment.Lock</span> <span class="dim">· 9 results</span></p>
                  <p data-at="1.1"><b class="g">●</b> Update <span class="arg">store/compact.go</span> <span class="add">+6</span> <span class="del">−2</span></p>
                  <p data-at="1.5"><b class="r">●</b> Bash <span class="arg">go test ./store/...</span></p>
                  <p data-at="1.6" class="out r">⎿ FAIL TestCompactRotate (0.21s)</p>
                  <p data-at="2.1"><b class="g">●</b> Update <span class="arg">store/segment.go</span> <span class="add">+17</span> <span class="del">−4</span></p>
                  <p data-at="2.7"><b class="b">●</b> Bash <span class="arg">go test -race -count=1 ./store/...</span></p>
                  <div data-at="3" data-until="3.7" class="ask">
                    <p>Do you want to proceed?</p>
                    <p><span class="b">❯ 1. Yes</span> <span class="dim">2. Yes, and don't ask again</span> <span class="dim">3. No</span></p>
                  </div>
                  <p data-at="3.7" class="out">⎿ ok  kinvault/store 4.18s</p>
                  <div data-at="3.9" class="reply">
                    <p>
                      <b class="fg">●</b> Fixed the race in the store's compaction path: writers now take the segment lock before
                      rotating, <mark>and all 42 tests pass under -race.</mark> I also added a regression test that rotates
                      during a compaction.
                    </p>
                  </div>
                </div>
              </article>
              <article class="win web">
                <header><span class="dots"><i></i><i></i><i></i></span><span>The Go Memory Model</span></header>
                <div class="doc">
                  <p class="kick">Documentation</p>
                  <h4>The Go Memory Model</h4>
                  <p>The Go memory model specifies the conditions under which reads of a variable in one goroutine can be guaranteed to observe values produced by writes to the same variable in a different goroutine.</p>
                  <h5>Advice</h5>
                  <p>Programs that modify data being simultaneously accessed by multiple goroutines must serialize such access. To serialize access, protect the data with channel operations or other synchronization primitives.</p>
                  <p class="skel"><i style="--w:92%"></i><i style="--w:84%"></i><i style="--w:88%"></i><i style="--w:60%"></i></p>
                  <p class="skel"><i style="--w:90%"></i><i style="--w:76%"></i></p>
                </div>
              </article>
            </div>
          </div>

          <div class="captions">
            <ol class="beats">
              {beats.map((b, i) => (
                <li data-beat={i} class={b.tone}>
                  <time class="mono">{b.at}</time>
                  <h2>{b.title}</h2>
                  <p>{b.body}</p>
                </li>
              ))}
            </ol>
            <p class="ack" data-ack aria-live="polite"></p>
            <nav class="ticks" aria-label="Moments in the session">
              {beats.map((b, i) => <button type="button" data-goto={i} aria-label={b.title}><i></i><span class="mono">{b.at.replace(" AM", "")}</span></button>)}
            </nav>
          </div>
        </div>
      </section>

      <!-- afternoon: the rest of the desk -->
      <section class="chapter wrap" id="moments" data-scene="moments" data-time="14:10" data-until="16:40" data-title="ember — the afternoon">
        <header class="head" data-rise>
          <p class="eyebrow"><time class="mono">2:30 PM</time> The rest of the desk</p>
          <h2>Everything else gets a moment, then gets out of the way.</h2>
          <p>Each one steps in, says what changed, and steps aside. Hover one to see it up top.</p>
        </header>
        <div class="specimens" data-group>
          {moments.map((m) => (
            <article class="spec" data-moment={m.kind} tabindex="0">
              <div class="hang"><div class={`mini pill moment m-${m.kind}`}><Moment kind={m.kind} /></div></div>
              <h3>{m.name}</h3>
              <p>{m.text}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- evening: the small mind -->
      <section class="chapter wrap mind" id="mind" data-scene="mind" data-time="18:40" data-until="21:30" data-title="ember — the evening">
        <header class="head" data-rise>
          <p class="eyebrow"><time class="mono">7:10 PM</time> A small mind</p>
          <h2>None of it is scripted animation.</h2>
          <p>
            A few small models run on real time, and the flame is where they show. Its energy follows the hour. Run your
            pointer along the day and watch it live each one.
          </p>
        </header>

        <figure class="day" data-day data-rise>
          <div class="day-flame"><ember-flame mood="idle" data-energy="0.5" data-dayflame></ember-flame><output class="mono" data-dayread>7:10 PM</output></div>
          <div class="plot">
            <svg class="curve" viewBox="0 0 960 220" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#72dd71" stop-opacity=".2" /><stop offset="1" stop-color="#72dd71" stop-opacity="0" /></linearGradient>
              </defs>
              <path class="area" data-area />
              <path class="line" data-line />
            </svg>
            <i class="cursor" data-cursor aria-hidden="true"><b></b></i>
            <div class="marks" aria-hidden="true">
              <span style="--x:12.5%" class="m">3 AM<em>lowest, asleep</em></span>
              <span style="--x:49.4%" class="m g">11:52 AM<em>a task done: a lift</em></span>
              <span style="--x:63%" class="m r">3:05 PM<em>an error: a sulk</em></span>
              <span style="--x:68.75%" class="m up">4:30 PM<em>at its brightest</em></span>
            </div>
            <div class="axis mono" aria-hidden="true"><span>12a</span><span>6a</span><span>12p</span><span>6p</span><span>12a</span></div>
          </div>
        </figure>

        <div class="models" data-group>
          <article class="model">
            <div class="viz blinks"><ember-flame mood="idle" data-energy="0.45" data-blinker></ember-flame><canvas data-raster width="560" height="72"></canvas></div>
            <h3>Life</h3>
            <p>Blinks are a Poisson process, about fifteen a minute, sometimes doubled. Those ticks are this flame's real blinks.</p>
          </article>
          <article class="model">
            <div class="viz attention" data-attention>
              <p><span>kinvault</span><i><b></b></i></p>
              <p><span>Instant Crush</span><i><b></b></i></p>
              <p><span>edge</span><i><b></b></i></p>
              <small class="mono" data-switches>switched 0× · without hysteresis 0×</small>
            </div>
            <h3>Attention</h3>
            <p>What the pill shows is scored, with hysteresis: a choice holds until a rival clearly beats it, so it never flickers between two close calls.</p>
          </article>
          <article class="model">
            <div class="viz presence"><span class="mini pill"><ember-flame class="lead" mood="happy"></ember-flame><span class="label">While you were away</span><span class="sub">kinvault done</span></span><small class="mono" data-presence>switch tabs for a few seconds, then come back</small></div>
            <h3>Presence</h3>
            <p>It knows when you've stepped away. News isn't shown to an empty room: you get it in one line when you're back.</p>
          </article>
          <article class="model">
            <div class="viz sleep"><span class="mini pill" data-sleepy><ember-flame class="lead" mood="idle"></ember-flame><span class="label" data-sleepclock>7:10 PM</span><span class="zz" aria-hidden="true"><i>z</i><i>z</i><i>z</i></span></span><small class="mono" data-idle>leave the page alone for a minute</small></div>
            <h3>Sleep</h3>
            <p>A quiet desk makes it drowsy, then it nods off with z's rising and the pill dimmed. Stop moving, and watch the top of this page.</p>
          </article>
        </div>
      </section>

      <!-- night: how it's built -->
      <section class="chapter wrap tool" id="tool" data-scene="tool" data-time="21:40" data-until="23:00" data-title="ember — how it's built">
        <header class="head" data-rise>
          <p class="eyebrow"><time class="mono">10:30 PM</time> Built like a small tool</p>
          <h2>No toolkit, no GPU, nothing that polls.</h2>
          <p>
            Ember speaks Wayland directly and draws every pixel itself, in Go, into shared memory. Everything it knows
            arrives as an event. When nothing moves, nothing is drawn but the flame.
          </p>
        </header>
        <div class="flow" data-flow data-rise>
          <ul class="sources">
            {sources.map((s) => <li data-src data-rate={s.rate} class={s.tone}><b>{s.name}</b><span>{s.via}</span></li>)}
          </ul>
          <div class="core" data-core>
            <ember-flame mood="idle" data-energy="0.6"></ember-flame>
            <b>ember</b>
            <span class="mono">one Go binary</span>
          </div>
          <div class="screen" data-screen>
            <span class="tiny-island" aria-hidden="true"><i></i></span>
            <b>The top of your screen</b>
            <span class="mono">wl_shm pixels on a layer-shell surface</span>
          </div>
          <svg class="wires" data-wires aria-hidden="true"></svg>
        </div>
        <p class="tally mono" data-tally><span data-events>0</span> events <i></i> <span>0</span> polls <i></i> <span data-frames>0</span> frames drawn</p>
        <dl class="numbers" data-group>
          <div><dt>memory, private</dt><dd><span data-count="9">≈9</span><small>MB</small></dd></div>
          <div><dt>of one core while Claude works</dt><dd><span data-count="1">≈1</span><small>%</small></dd></div>
          <div><dt>binary to install</dt><dd>1</dd></div>
          <div><dt>polling loops</dt><dd>0</dd></div>
        </dl>
      </section>

      <!-- late: the real thing -->
      <section class="chapter wrap real" id="real" data-scene="real" data-time="23:00" data-until="24:20" data-title="ember — the real thing">
        <header class="head" data-rise>
          <p class="eyebrow"><time class="mono">11:20 PM</time> The real thing</p>
          <h2>Everything above was this page pretending.</h2>
          <p>
            Below is Ember itself: every frame drawn by its own renderer, the same code that runs at the top of the
            screen, played from a script.
          </p>
        </header>
        <figure class="shot big" data-rise>
          <div class="crop"><img src={media("claude.webp")} alt="Ember on a desktop: the pill names the session at work, the card drops with its live timeline, a request to run the store tests is allowed from the island, and the pill says Done with Claude's summary" loading="lazy" width="1520" height="660" /></div>
          <figcaption><b>Fourteen seconds of a session,</b> drawn frame by frame by Ember's own renderer.</figcaption>
        </figure>
        <div class="pair">
          <figure class="shot" data-rise>
            <img src={media("music.webp")} alt="The music demo: the cover in a ring in the pill, then the card's now playing section on a haze of the cover's colours, pause and play, and the volume rising to 100" loading="lazy" width="880" height="420" />
            <figcaption><b>Now playing</b> lights the card in the cover's own colours.</figcaption>
          </figure>
          <figure class="shot" data-rise>
            <img src={media("dash.webp")} alt="The edge plugin's dashboard opening: a ring for the day's goal, the problem in progress, the week's bars, a rating line and a year of practice as a heatmap" loading="lazy" width="1520" height="760" />
            <figcaption><b>Plugins</b> sleep until their tool is installed. The first, edge, is a practice coach.</figcaption>
          </figure>
        </div>
        <div class="reel-wrap" data-rise>
          <div class="reel" data-reel tabindex="0" aria-label="Stills from Ember's renderer">
            {reel.map((r) => (
              <figure>
                <img src={media(r.src)} alt={r.cap} loading="lazy" />
                <figcaption>{r.cap}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="chapter wrap install" id="install" data-scene="install" data-time="24:20" data-until="25:50" data-title="ember — install">
        <header class="head center" data-rise>
          <p class="eyebrow"><time class="mono">12:40 AM</time> Install</p>
          <h2>Three lines, one of which is a check-up.</h2>
        </header>
        <div class="terminal" data-rise>
          <div class="tbar"><span class="dots"><i></i><i></i><i></i></span><span class="mono">~</span><button type="button" data-copy>Copy</button></div>
          <pre><code><span class="c"># a Wayland compositor with layer-shell, Go 1.27+, systemd</span>
<span class="ps">$ </span>git clone https://github.com/Tejas242/ember &amp;&amp; cd ember
<span class="ps">$ </span>make install    <span class="c"># the binary, a user service, Claude Code's hooks, a config</span>
<span class="ps">$ </span>ember doctor    <span class="c"># says what's missing, and how to get it</span></code></pre>
        </div>
        <p class="small center" data-rise>
          Made for <b>niri</b> with the <b>Noctalia</b> shell; anything with <code>zwlr_layer_shell_v1</code> should do.
          Music needs an MPRIS player, the equaliser PipeWire. The <a href={`${repo}#config`}>config</a> takes effect
          within ten seconds, without a restart.
        </p>
      </section>

      <!-- 2 AM: good night -->
      <section class="finale" data-scene="night" data-time="25:50" data-until="26:14" data-title="ember — 2 AM">
        <div class="sleeper" data-sleeper title="Shh.">
          <ember-flame mood="sleep" data-energy="0.1"></ember-flame>
          <span class="zz" aria-hidden="true"><i>z</i><i>z</i><i>z</i></span>
        </div>
        <h2 data-rise>Good night.</h2>
        <p data-rise>It'll be up there in the morning, keeping the time.</p>
        <div class="ctas" data-rise>
          <a class="cta primary" href={repo}>Get Ember on GitHub</a>
          <a class="cta" href={`${repo}/blob/main/docs/DESIGN.md`}>Read how it's designed</a>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <p>
        Ember is <a href={`${repo}/blob/main/LICENSE`}>MIT licensed</a>. Made by
        <a href="https://screenager.dev">Tejas Mahajan</a>, who now finds out his tests passed from the top of the screen.
      </p>
      <nav><a href={repo}>GitHub</a><a href={`${repo}/blob/main/docs/DESIGN.md`}>Design</a><a href={`${repo}/issues`}>Issues</a></nav>
    </footer>

    <script>
      import "@/scripts/page"
    </script>
  </body>
</html>
